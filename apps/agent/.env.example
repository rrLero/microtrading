# Copy to .env — .env is gitignored. NEVER commit real keys.
DATABASE_URL=postgres://micro:micro@localhost:55432/microtrading

# Trading universe (SPEC §2.2: BTC/USDC only in V1)
SYMBOL=BTC/USDC

# Data source exchange for ingestion (public endpoints, no keys needed in Phase 0-2)
DATA_EXCHANGE=kraken

# Backfill window start (SPEC §2.4: 2019 to cover a full regime cycle)
BACKFILL_SINCE=2019-01-01T00:00:00Z

# --- Paper trading loop (Phase 2) ---
# The loop only runs when explicitly enabled. Decisions on closed 1h candles,
# same code path as the backtester. Kill switch: pnpm kill-switch -- on
ENABLE_TRADING_LOOP=false
STRATEGY_FAMILY=donchian-breakout
STRATEGY_PARAMS={"entryLookback":40,"exitLookback":10}
PAPER_INITIAL_CASH=10000

# --- Ops (Phase 3) ---
# Read-only API port (dashboard reads from here; no mutating endpoints)
PORT=3001
# Push alerts: pick a hard-to-guess topic (it IS the auth on ntfy.sh free tier),
# subscribe to the same topic in the ntfy mobile app. Unset = log-only.
# NTFY_TOPIC=microtrading-lero-CHANGE-ME-x7k2f9

# API keys only needed from Phase 3 (Bybit demo) onward. When BOTH demo keys
# are set, every fresh paper fill is mirrored to Bybit demo (�6.3 calibration)
# and compared via: pnpm calibrate-report
# SPEC §8/§9: least privilege, withdrawal permission NEVER granted, IP-allowlisted.
# BYBIT_DEMO_API_KEY=
# BYBIT_DEMO_API_SECRET=
